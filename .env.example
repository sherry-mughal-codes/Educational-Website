# ==============================================================================
# FBISE Educational Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the development environment:
# cp .env.example .env
#
# DO NOT commit real secrets, API keys, or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend & Django Configuration
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-dev-key-fbise-replace-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=fbise_db
POSTGRES_USER=fbise_user
POSTGRES_PASSWORD=fbise_dev_password_change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# CORS Configuration (Frontend to Backend communication)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ------------------------------------------------------------------------------
# Frontend & Next.js Configuration
# ------------------------------------------------------------------------------
# Note: Host port 3001 is used by default to prevent port collision with other local containers.
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# ------------------------------------------------------------------------------
# File Upload Configuration
# ------------------------------------------------------------------------------
# Maximum PDF upload size in megabytes (default: 50MB)
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# Google Analytics 4 (GA4)
# ------------------------------------------------------------------------------
# Leave empty in development if you do not want to send tracking events.
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Set to true to view events in GA4 DebugView / Realtime without polluting production data
NEXT_PUBLIC_GA_DEBUG_MODE=false

# ------------------------------------------------------------------------------
# Transactional Email Configuration (SMTP)
# ------------------------------------------------------------------------------
# In local development, defaults to console backend.
# Set these when integrating an SMTP provider (e.g. SendGrid, Amazon SES, Mailgun, Gmail SMTP).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FBISE Study Notes <noreply@fbise-notes.local>

# ------------------------------------------------------------------------------
# Pakistani Payment Gateway Configuration (JazzCash & Easypaisa)
# ------------------------------------------------------------------------------
# Default gateway selection: jazzcash, easypaisa, or sandbox
PAYMENT_GATEWAY_DEFAULT=jazzcash
# Enable sandbox simulated checkout for automated testing without live merchant accounts
PAYMENT_SANDBOX_ENABLED=true

# JazzCash Merchant Credentials (Obtained from JazzCash Merchant Portal)
JAZZ_CASH_MERCHANT_ID=
JAZZ_CASH_PASSWORD=
JAZZ_CASH_INTEGRITY_SALT=
JAZZ_CASH_RETURN_URL=http://localhost:3001/checkout/result/
JAZZ_CASH_ENDPOINT=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/

# Easypaisa Merchant Credentials (Obtained from Easypaisa Developer / Merchant Portal)
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=http://localhost:3001/checkout/result/
EASYPAISA_ENDPOINT=https://easypay.easypaisa.com.pk/easypay/Index.jsf

